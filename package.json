{
  "name": "tonmen-console",
  "version": "1.0.0",
  "description": "受治理的自主安全运行时控制台",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "esbuild": "^0.20.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
